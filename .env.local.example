# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # From @BotFather
TELEGRAM_WEBHOOK_SECRET=      # Random string — verifies incoming webhook requests
TELEGRAM_ALLOWED_CHAT_IDS=    # Comma-separated chat IDs allowed to record (blank = allow all)
                              #   Find yours by messaging @userinfobot

# ── AI vision / OCR provider ──────────────────────────────────────────────────
# Groq (free tier). Get a key at console.groq.com/keys
GROQ_API_KEY=                 # From console.groq.com/keys (free tier available)
AI_MODEL=llama-3.2-11b-vision-preview  # Groq vision-capable model id

# ── Google Sheets (single source of truth) ────────────────────────────────────
GOOGLE_SHEETS_ID=             # The long id in the Sheet URL: /spreadsheets/d/<THIS>/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL= # service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=           # "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
                              #   Newlines must be literal \n inside the quotes

# ── Deployment ────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=             # Public base URL of this app (Vercel URL or ngrok URL)
                              #   Used by scripts/register-webhook.ts
