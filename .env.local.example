# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # From @BotFather on Telegram
TELEGRAM_WEBHOOK_SECRET=      # Random string — used to verify incoming webhook requests
TELEGRAM_ALLOWED_CHAT_IDS=    # Comma-separated Telegram chat IDs to allow (leave blank = no restriction)
                               # Find your ID by messaging @userinfobot

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=               # From Google AI Studio: aistudio.google.com/app/apikey

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=              # The long ID from the Google Sheets URL
                               # sheets.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL= # service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=           # "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
                               # Copy from the service account JSON key file
                               # Newlines must be literal \n (not actual newlines) in .env files

# ── Deployment ────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=             # Public URL of this deployed app
                               # e.g. https://tokyo-solo.vercel.app
                               # or ngrok URL for local testing: https://xxxx.ngrok-free.app
